let
  type shit = {a: int, b: int}
  type shitass = {a: int, b: shit}
  type intarr = array of int

  var balls := 10
  var arr := intarr [5] of 0
  var huh := shit {a=6, b=7}

  function f(a:int, n:int) : int = (
    let
      var x := 10
      function g(b:int) : int = a + b
    in
      a + g(2)
    end
  )
in 
  f(balls, 67);
  arr[balls] := 2;
  while balls < 5 do ( balls := balls+1; huh.a := huh.a - 1);
  for i:=0 to 10 do (balls := i);
end
