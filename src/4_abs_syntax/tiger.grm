
%debug

%{
#include <stdio.h>
#include "util.h"
#include "symbol.h" 
#include "errormsg.h"
#include "absyn.h"

extern int yylineno;
extern char* yytext;
extern char curr_line[];

int EM_err_count = 0;
A_exp absyn_root = NULL;

int yylex(void); /* function prototype */

void yyerror(char *s)
{

 
 EM_error(EM_tokPos, "\"%s\"\n\t\t%s in line %d, near '%s'\n", curr_line, s, yylineno, yytext);
 EM_err_count += 1;

}
%}


%union {

	int pos;
	int ival;
	string sval;

	A_var var;
	A_exp exp;
  A_dec dec;
  A_ty ty;
  A_field field;
  A_fundec fundec;
  A_namety namety;
  A_efield efield;

  A_decList decl;
  A_expList expl;
  A_fieldList fieldl;
  A_fundecList fundecl;
  A_nametyList nametyl;
  A_efieldList efieldl;

	}

%token <sval> ID STRING
%token <ival> INT

%token 
  COMMA COLON SEMICOLON LPAREN RPAREN LBRACK RBRACK 
  LBRACE RBRACE DOT 
  PLUS MINUS TIMES DIVIDE EQ NEQ LT LE GT GE
  AND OR ASSIGN
  ARRAY IF THEN ELSE WHILE FOR TO DO LET IN END OF 
  BREAK NIL
  FUNCTION VAR TYPE 

%left OR
%left AND
%left EQ NEQ LT LE GT GE
%left PLUS MINUS
%left TIMES DIVIDE

%type <exp> exp expseq program arrdec
%type <dec> dec vardec 
%type <ty> ty

%type <expl> fparams
%type <decl> decs
%type <fieldl> typefields
%type <nametyl> tydec fundec
%type <fundecl> fundec

%start prog

%%

prog
    :	exp { absyn_root=$1; }

let
    : LET decs IN expseq END { $$ = A_LetExp(EM_tokPos, $2, $4); }
    ;

decs
    : dec decs { $$ = A_DecList($1, $2); }
    | error decs { $$ = A_DecList(NULL, $2); }
    | { $$ = NULL; }
    ;

dec
    : tydec { $$ = A_TypeDec(EM_tokPos, $1); }
    | vardec { $$ = $1; }
    | fundec { $$ = A_FunctionDec(EM_tokPos, $1); }
    ;

tydec
    : TYPE ID EQ ty { $$ = A_NametyList(A_Namety(S_Symbol($2), $4), NULL); }
ty
    : ID { $$ = A_NameTy(EM_tokPos, S_Symbol($1)); }
    | LBRACE tyfields RBRACE { $$ = A_RecordTy(EM_tokPos, $2); }
    | ARRAY OF ID { $$ = A_ArrayTy(EM_tokPos, S_Symbol($3)); }
    ;
tyfields
    : ID COLON ID { $$ = A_FieldList(A_Field(EM_tokPos, S_Symbol($1), S_Symbol($3)), NULL); }
    | ID COLON ID COMMA tyfields { $$ = A_FieldList(A_Field(EM_tokPos, S_Symbol($1), S_Symbol($3)), $5); }
    | { $ = NULL }
    ;

vardec
    : VAR ID ASSIGN exp { $$ = A_VarDec(EM_tokPos, S_Symbol($2), NULL, $4); }
    | VAR ID COLON ID ASSIGN exp { $$ = A_VarDec(EM_tokPos, S_Symbol($2), S_Symbol($4), $6); }
    ;

arrdec
    : ID LBRACK exp RBRACK OF exp { $$ = A_ArrayExp(EM_tokPos, S_Symbol($1), $3, $6); }
    | ID NIL { $$ = $$ = A_ArrayExp(EM_tokPos, S_Symbol($1), NULL, NULL); }
    ;

fundec
    : FUNCTION ID LPAREN tyfields RPAREN EQ exp { $$ = A_FundecList(A_Fundec(EM_tokPos, S_Symbol($2), $4, NULL, $7)); }
    | FUNCTION ID LPAREN tyfields RPAREN COLON ID EQ exp { $$ = A_FundecList(A_Fundec(EM_tokPos, S_Symbol($2), $4, S_Symbol($7), $9)); }
    ;

lvalue
    : ID lvalue_suffix { $$ = }
    ;

lvalue_suffix
    : DOT ID lvalue_suffix
    | LBRACK exp RBRACK lvalue_suffix
    |
    ;

fparams
    : IF exp THEN exp ELSE exp COMMA fparams { $$ = A_ExpList(A_IfExp(EM_tokPos, $2, $4, $6), $8); }
    | exp COMMA fparams { $$ = A_ExpList($1, $3); }
    | IF exp THEN exp ELSE exp { $$ = A_ExpList(A_IfExp(EM_tokPos, $2, $4, $6), NULL); }
    | exp { $$ = A_ExpList($1, NULL); }
    | { $$ = NULL; }
    ;

valess
    : ID LPAREN fparams RPAREN
    | lvalue ASSIGN exp
    | IF exp THEN expseq ELSE expseq
    | IF exp THEN expseq
    | WHILE exp DO expseq
    | FOR ID ASSIGN exp TO exp DO expseq
    | BREAK
    ;

recpara
    : ID EQ exp
    | recpara COMMA recpara
    |
    ;
rec
    : ID LBRACE recpara RBRACE

expseq
    : exp { $$ =  }
    | expseq SEMICOLON exp
    | error SEMICOLON exp
    |
    ;
exp
    : exp OR exp
    | exp AND exp
    | exp EQ exp
    | exp NEQ exp
    | exp LT exp
    | exp LE exp
    | exp GT exp
    | exp GE exp
    | exp LT GT exp
    | exp PLUS exp { $$ = $1 + $3; }
    | MINUS exp
    | exp MINUS exp
    | exp TIMES exp
    | exp DIVIDE exp
    | valess
    | lvalue
    | arrdec
    | rec
    | let
    | NIL { $$ = A_NilExp(EM_tokPos); }
    | INT { $$ = A_IntExp(EM_tokPos, $1); }
    | STRING { $$ = A_StringExp(EM_tokPos, $1); }
    | LPAREN expseq RPAREN
    | LPAREN error RPAREN
    ;

