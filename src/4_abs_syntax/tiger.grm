
%debug

%{
#include <stdio.h>
#include "util.h"
#include "symbol.h" 
#include "errormsg.h"
#include "absyn.h"

extern int yylineno;
extern char* yytext;
extern char curr_line[];

int EM_err_count = 0;
A_exp absyn_root = NULL;

int yylex(void); /* function prototype */

void yyerror(char *s)
{

 
 EM_error(EM_tokPos, "\"%s\"\n\t\t%s in line %d, near '%s'\n", curr_line, s, yylineno, yytext);
 EM_err_count += 1;

}
%}


%union {

	int pos;
	int ival;
	string sval;

	A_var var;
	A_exp exp;
  A_dec dec;
  A_ty ty;
  A_field field;
  A_fundec fundec;
  A_namety namety;
  A_efield efield;

  A_decList decl;
  A_expList expl;
  A_fieldList fieldl;
  A_fundecList fundecl;
  A_nametyList nametyl;
  A_efieldList efieldl;

	}

%token <sval> ID STRING
%token <ival> INT

%token 
  COMMA COLON SEMICOLON LPAREN RPAREN LBRACK RBRACK 
  LBRACE RBRACE DOT 
  PLUS MINUS TIMES DIVIDE EQ NEQ LT LE GT GE
  AND OR ASSIGN
  ARRAY IF THEN ELSE WHILE FOR TO DO LET IN END OF 
  BREAK NIL
  FUNCTION VAR TYPE 

%left OR
%left AND
%left EQ NEQ LT LE GT GE
%left PLUS MINUS
%left TIMES DIVIDE

%type <exp> exp expseq prog arrdec valess rec let
%type <dec> dec vardec 
%type <ty> ty
%type <var> lvalue

%type <expl> fparams
%type <decl> decs
%type <fieldl> tyfields
%type <nametyl> tydec 
%type <fundecl> fundec
%type <efieldl> recpara

%start prog

%%

prog
    :	exp { absyn_root=$1; }

let
    : LET decs IN expseq END { $$ = A_LetExp(EM_tokPos, $2, $4); }
    ;

decs
    : dec decs { $$ = A_DecList($1, $2); }
    | error decs { $$ = A_DecList(NULL, $2); }
    | { $$ = NULL; }
    ;

dec
    : tydec { $$ = A_TypeDec(EM_tokPos, $1); }
    | vardec { $$ = $1; }
    | fundec { $$ = A_FunctionDec(EM_tokPos, $1); }
    ;

tydec
    : TYPE ID EQ ty { $$ = A_NametyList(A_Namety(S_Symbol($2), $4), NULL); }
ty
    : ID { $$ = A_NameTy(EM_tokPos, S_Symbol($1)); }
    | LBRACE tyfields RBRACE { $$ = A_RecordTy(EM_tokPos, $2); }
    | ARRAY OF ID { $$ = A_ArrayTy(EM_tokPos, S_Symbol($3)); }
    ;
tyfields
    : ID COLON ID { $$ = A_FieldList(A_Field(EM_tokPos, S_Symbol($1), S_Symbol($3)), NULL); }
    | ID COLON ID COMMA tyfields { $$ = A_FieldList(A_Field(EM_tokPos, S_Symbol($1), S_Symbol($3)), $5); }
    | { $$ = NULL; }
    ;

vardec
    : VAR ID ASSIGN exp { $$ = A_VarDec(EM_tokPos, S_Symbol($2), NULL, $4); }
    | VAR ID COLON ID ASSIGN exp { $$ = A_VarDec(EM_tokPos, S_Symbol($2), S_Symbol($4), $6); }
    ;

arrdec
    : ID LBRACK exp RBRACK OF exp { $$ = A_ArrayExp(EM_tokPos, S_Symbol($1), $3, $6); }
    | ID NIL { $$ = $$ = A_ArrayExp(EM_tokPos, S_Symbol($1), NULL, NULL); }
    ;

fundec
    : FUNCTION ID LPAREN tyfields RPAREN EQ exp { $$ = A_FundecList(A_Fundec(EM_tokPos, S_Symbol($2), $4, NULL, $7), NULL); }
    | FUNCTION ID LPAREN tyfields RPAREN COLON ID EQ exp { $$ = A_FundecList(A_Fundec(EM_tokPos, S_Symbol($2), $4, S_Symbol($7), $9), NULL); }
    ;

lvalue
    : ID { $$ = A_SimpleVar(EM_tokPos, S_Symbol($1)); } 
    | lvalue DOT ID { $$ = A_FieldVar(EM_tokPos, $1, S_Symbol($3)); }
    | lvalue LBRACK exp RBRACK { $$ = A_SubscriptVar(EM_tokPos, $1, $3); }
    | ID LBRACK exp RBRACK { $$ = A_SubscriptVar(EM_tokPos, A_SimpleVar(EM_tokPos, S_Symbol($1)), $3); } /* shit solution */
    ;

fparams
    : IF exp THEN exp ELSE exp COMMA fparams { $$ = A_ExpList(A_IfExp(EM_tokPos, $2, $4, $6), $8); }
    | exp COMMA fparams { $$ = A_ExpList($1, $3); }
    | IF exp THEN exp ELSE exp { $$ = A_ExpList(A_IfExp(EM_tokPos, $2, $4, $6), NULL); }
    | exp { $$ = A_ExpList($1, NULL); }
    | { $$ = NULL; }
    ;

valess
    : ID LPAREN fparams RPAREN { $$ = A_CallExp(EM_tokPos, S_Symbol($1), $3); }
    | lvalue ASSIGN exp { $$ = A_AssignExp(EM_tokPos, $1, $3); }
    | IF exp THEN expseq ELSE expseq { $$ = A_IfExp(EM_tokPos, $2, $4, $6); }
    | IF exp THEN expseq { $$ = A_IfExp(EM_tokPos, $2, $4, NULL); }
    | WHILE exp DO expseq { $$ = A_WhileExp(EM_tokPos, $2, $4); }
    | FOR ID ASSIGN exp TO exp DO expseq { $$ = A_ForExp(EM_tokPos, S_Symbol($2), $4, $6, $8); }
    | BREAK { $$ = A_BreakExp(EM_tokPos); }
    ;

recpara
    : ID EQ exp { $$ = A_EfieldList(A_Efield(S_Symbol($1), $3), NULL); }
    | ID EQ exp COMMA recpara { $$ = A_EfieldList(A_Efield(S_Symbol($1), $3), $5); }
    | { $$ = NULL; }
    ;
rec
    : ID LBRACE recpara RBRACE { $$ = A_RecordExp(EM_tokPos, S_Symbol($1), $3); }

expseq
    : exp { $$ =  $1; }
    | expseq SEMICOLON exp { $$ = A_SeqExp(EM_tokPos, A_ExpList($1, A_ExpList($3, NULL))); }
    | error SEMICOLON exp { $$ = A_SeqExp(EM_tokPos, A_ExpList(NULL, A_ExpList($3, NULL))); }
    |
    ;
exp
    : exp OR exp { $$ = A_OpExp(EM_tokPos, A_orOp, $1, $3); }
    | exp AND exp { $$ = A_OpExp(EM_tokPos, A_andOp, $1, $3); }
    | exp EQ exp { $$ = A_OpExp(EM_tokPos, A_eqOp, $1, $3); }
    | exp NEQ exp { $$ = A_OpExp(EM_tokPos, A_neqOp, $1, $3); }
    | exp LT exp { $$ = A_OpExp(EM_tokPos, A_ltOp, $1, $3); }
    | exp LE exp { $$ = A_OpExp(EM_tokPos, A_leOp, $1, $3); }
    | exp GT exp { $$ = A_OpExp(EM_tokPos, A_gtOp, $1, $3); }
    | exp GE exp { $$ = A_OpExp(EM_tokPos, A_geOp, $1, $3); }
    | exp PLUS exp { $$ = A_OpExp(EM_tokPos, A_plusOp, $1, $3); }
    | MINUS exp { $$ = A_OpExp(EM_tokPos, A_timesOp, $2, A_IntExp(EM_tokPos, -1)); }
    | exp MINUS exp { $$ = A_OpExp(EM_tokPos, A_minusOp, $1, $3); }
    | exp TIMES exp { $$ = A_OpExp(EM_tokPos, A_timesOp, $1, $3); }
    | exp DIVIDE exp { $$ = A_OpExp(EM_tokPos, A_divideOp, $1, $3); }
    | valess { $$ = $1; }
    | lvalue { $$ = A_VarExp(EM_tokPos, $1); }
    | arrdec { $$ = $1; }
    | rec { $$ = $1; }
    | let { $$ = $1; }
    | NIL { $$ = A_NilExp(EM_tokPos); }
    | INT { $$ = A_IntExp(EM_tokPos, $1); }
    | STRING { $$ = A_StringExp(EM_tokPos, $1); }
    | LPAREN expseq RPAREN { $$ = $2; }
    | LPAREN error RPAREN { $$ = NULL; }
    ;

